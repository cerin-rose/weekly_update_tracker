# Server-side Google Sheets API
GOOGLE_SPREADSHEET_ID=your-google-spreadsheet-id
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account-email
# Keep the private key server-side. In Vercel, store line breaks as \\n
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"

# Server-side document importer
OPENAI_API_KEY=replace-with-an-openai-key
OPENAI_MODEL=gpt-4o-mini
# Required in Vercel production to enforce a shared daily AI budget.
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-an-upstash-token
AI_IMPORT_DAILY_LIMIT=20
AI_IMPORT_USER_DAILY_LIMIT=10

# Required in Vercel Production to protect student data
DASHBOARD_ACCESS_PASSWORD=replace-with-a-shared-team-password
DASHBOARD_SESSION_SECRET=replace-with-a-long-random-secret
